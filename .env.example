# Meta Conversions API (server-side; never expose with NEXT_PUBLIC_)
META_CONVERSIONS_ACCESS_TOKEN=
# Optional while validating events in Meta Events Manager
META_TEST_EVENT_CODE=

# Public storefront identity and canonical URL
NEXT_PUBLIC_SITE_NAME="Gloss & Glows"
NEXT_PUBLIC_SITE_DESCRIPTION="Shop beauty and lifestyle products from Gloss & Glows with fast delivery across Bangladesh."
NEXT_PUBLIC_SITE_URL="https://glossandglows.com"

# Firebase Cloud Messaging (server-side only; never expose with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store the PEM private key with literal \n sequences in hosted environment variables.
FIREBASE_PRIVATE_KEY=
# FCM topic used by the mobile apps: new-products

# Customer/order personal-data retention
# The scheduled retention worker anonymizes OMS customer PII older than this age.
CUSTOMER_DATA_RETENTION_DAYS=90
# Maximum records processed per database batch.
CUSTOMER_DATA_RETENTION_BATCH_SIZE=250
# Safety switch. Keep false for the first Railway cron dry run.
# Change to true only after reviewing the dry-run count.
CUSTOMER_DATA_RETENTION_EXECUTE=false
